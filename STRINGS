class Solution {

public void reverseString(char[] s) {

int l=0;

int r=s.length-1;

while(l<r){

char t=s[l];

s[l]=s[r];

s[r]=t;

l++;

r--;

}

}

}

LEETCODE-876

class Solution {

public ListNode middleNode(ListNode head) {

ListNode slow=head;

ListNode fast=head;

while(fast!=null && fast.next!=null){

slow=slow.next;

fast=fast.next.next;

}

return slow;

}

}

LEETCODE-387

class Solution {

public int firstUniqChar(String s) {

for(int i=0;i<s.length();i++){

char ch=s.charAt(i);

if(s.indexOf(ch)==s.lastIndexOf(ch)){

return i;

}

}

return -1;

}

}

LEETCODE-205

class Solution {

public boolean isIsomorphic(String s, String t) {

for(int i=0;i<s.length();i++){

char c=s.charAt(i);

char d=t.charAt(i);

if(s.indexOf(c)!=t.indexOf(d)){

return false;

}

}

return true;

}

}

